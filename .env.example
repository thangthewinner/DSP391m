# Model paths
MODEL_CACHE_DIR=./models
HF_HOME=./models/.cache

# API configuration
API_HOST=0.0.0.0
API_PORT=8000
WS_MAX_SIZE=10485760

# Processing configuration
AUDIO_SAMPLE_RATE=16000
AUDIO_CHUNK_SIZE=2.0
VAD_THRESHOLD=0.5
BUFFER_SIZE=10.0

# Detection thresholds
SIMILARITY_THRESHOLD_LOW=0.50
SIMILARITY_THRESHOLD_HIGH=0.75
SPEAKER_VERIFICATION_THRESHOLD=0.75

# API payload schema versions (frontend/backend contract)
EVENT_SCHEMA_VERSION=1.0.0
REPORT_SCHEMA_VERSION=1.0.0

# Storage
STORAGE_ROOT=./storage
DEBUG_SAVE_AUDIO=false
STORAGE_RETENTION_DAYS=30

# Device configuration
# Use 'cpu' for CPU-only systems, 'cuda' for GPU systems
TORCH_DEVICE=cpu
# Optional custom STT CTranslate2 model path (default uses model name: large-v3)
# STT_MODEL_PATH=./models/stt/whisper-large-v3-ct2

# For GPU systems, uncomment and set:
# CUDA_VISIBLE_DEVICES=0
# TORCH_DEVICE=cuda

# Diarization / Overlap Detection (Phase 6)
# Download model first: uv run python scripts/download_models.py --diarization
DIARIZATION_ENABLED=true
# DIARIZATION_MODEL_PATH=./models/diarization/diar_streaming_sortformer_4spk-v2.nemo
# MIN_DIARIZATION_AUDIO_SECONDS=10.0   # min audio length for reliable diarization
# DIARIZATION_WINDOW_SECONDS=15.0      # sliding analysis window
# DIARIZATION_STEP_SECONDS=7.5         # run interval between windows

# Speaker Verification (Phase 5)
# Enrollments saved to storage/enrollment/{student_id}.npy
SPEAKER_VERIFICATION_ENABLED=true
SPEAKER_VERIFICATION_THRESHOLD=0.75
VERIFICATION_INTERVAL=300        # seconds between checks (default: 5 min)
VERIFICATION_MAX_FAILURES=3      # session terminates after N failed verifications
MIN_VERIFICATION_AUDIO_SECONDS=3.0
MIN_ENROLLMENT_SAMPLES=3         # minimum audio samples for enrollment

# SLM Configuration (Phase 3 — Reasoning Layer)
# Download model first: uv run python scripts/download_models.py --slm
SLM_ENABLED=true
# SLM_MODEL_PATH=./models/slm/qwen2.5-3b-instruct-q4_k_m.gguf
# SLM_N_GPU_LAYERS=0   # 0=CPU only. -1=all layers on GPU (needs VRAM)
# SLM_MAX_TOKENS=4
# SLM_CONTEXT_LENGTH=512
